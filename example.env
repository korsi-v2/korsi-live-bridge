#
# copy this file as .env

# AppAPI environment variables
AA_VERSION=3.2.0
APP_SECRET=12345
APP_ID=korsi_live_bridge
APP_DISPLAY_NAME="Korsi Live Meeting Bridge"
APP_VERSION=1.0.0
APP_PROTOCOL=http
APP_HOST=0.0.0.0
APP_PORT=23000
APP_PERSISTENT_STORAGE=persistent_storage
NEXTCLOUD_URL=

# Nextcloud Talk's High Performance Backend, and the internal secret from Talk's signaling settings.
# The bridge authenticates to the HPB as an internal client with this secret, which is what lets it
# join a room's signaling without being a participant of the conversation.
LT_HPB_URL="wss://nextcloud.nc.ncweb/standalone-signaling/spreed"
LT_INTERNAL_SECRET=oompaloompa

SKIP_CERT_VERIFY=false

# ---------------------------------------------------------------------------
# Korsi
# ---------------------------------------------------------------------------
# Where to ask which rooms to watch, and who to ask as. `make provision-bridge slug=<tenant>` in
# korsi-api prints all four values; none of them should be composed by hand.
#
# KORSI_TOKEN_SCOPE is not a list of permissions. It carries three ZITADEL reserved URNs -- the
# korsi-api audience, the project-roles assertion and the acting organization -- and dropping any one
# of them yields a token that is valid, correctly signed and refused, for a reason that looks nothing
# like a missing scope. Paste it verbatim.
#
# KORSI_SERVICE_KEY is the whole JSON document ZITADEL generated, on one line. The bridge signs a
# one-minute assertion with it and exchanges that for an access token, so the private key never leaves
# this container.
#
# There is no speech-provider key here on purpose. Korsi mints a temporary, session-scoped one per call
# and hands it over when it accepts the call, so no long-lived Korsi credential sits in this container.
KORSI_API_URL="https://api.korsi.ai"
KORSI_TOKEN_URL="https://auth.korsi.ai/oauth/v2/token"
KORSI_TOKEN_SCOPE="openid urn:zitadel:iam:org:project:id:REPLACE_ME:aud urn:zitadel:iam:org:projects:roles urn:zitadel:iam:org:id:REPLACE_ME"
KORSI_SERVICE_KEY=
