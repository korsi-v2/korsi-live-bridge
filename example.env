#
# copy this file as .env

# AppAPI environment variables
AA_VERSION=3.2.0
APP_SECRET=12345
APP_ID=korsi_live_bridge
APP_DISPLAY_NAME="Korsi Live Meeting Bridge"
APP_VERSION=1.0.0
APP_PROTOCOL=http
APP_HOST=0.0.0.0
APP_PORT=23000
APP_PERSISTENT_STORAGE=persistent_storage
NEXTCLOUD_URL=

# Nextcloud Talk's High Performance Backend, and the internal secret from Talk's signaling settings.
# The bridge authenticates to the HPB as an internal client with this secret, which is what lets it
# join a room's signaling without being a participant of the conversation.
LT_HPB_URL="wss://nextcloud.nc.ncweb/standalone-signaling/spreed"
LT_INTERNAL_SECRET=oompaloompa

SKIP_CERT_VERIFY=false

# ---------------------------------------------------------------------------
# Korsi
# ---------------------------------------------------------------------------
# Where to ask which rooms to watch, and who to ask as. Korsi's provisioning produces all five values;
# none of them should be composed by hand.
#
# KORSI_TOKEN_SCOPE in particular is not a list of permissions -- it carries the ZITADEL audience URN
# that addresses the token to korsi-api. Without the right audience the token is valid and useless: the
# project roles land in a claim korsi-api does not read, and every call is refused as unauthorized.
#
# There is no speech-provider key here on purpose. Korsi mints a temporary, session-scoped one per call
# and hands it over when it accepts the call, so no long-lived Korsi credential sits in this container.
KORSI_API_URL="https://api.korsi.ai"
KORSI_TOKEN_URL="https://auth.korsi.ai/oauth/v2/token"
KORSI_CLIENT_ID=
KORSI_CLIENT_SECRET=
KORSI_TOKEN_SCOPE="openid profile urn:zitadel:iam:org:project:id:REPLACE_ME:aud"
